{
  "info": {
    "name": "Kampüs API — Abdelrahman Zidan — Sprint 8",
    "description": "2321032807. Önce npm run seed, sonra npm run dev. 1–6 sırasıyla çalıştırın. \"2 Etkinlik listesi\" ilk kaydın _id değerini {{eventId}} değişkenine kaydeder; \"3 Tek etkinlik\" bu değişkeni kullanır. POST ile eklenen kayıt MongoDB'de kalıcıdır.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Sağlık kontrolü",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "health"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Yanıt sözleşmesi\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data.status).to.eql(\"ok\"); pm.expect(data.student).to.eql(\"2321032807\"); pm.expect(new Date(data.time).toISOString()).to.eql(data.time);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Etkinlik listesi",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Yanıt sözleşmesi (seed sonrası 6 kayıt)\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data).to.be.an(\"array\").with.lengthOf(6);",
              "  data.forEach((e) => { pm.expect(e).to.have.property(\"_id\"); pm.expect(e).to.have.property(\"createdAt\"); pm.expect(e).to.have.property(\"updatedAt\"); });",
              "  pm.collectionVariables.set(\"eventId\", data[0]._id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Tek etkinlik",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/events/{{eventId}}",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events",
            "{{eventId}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Yanıt sözleşmesi\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data._id).to.eql(pm.collectionVariables.get(\"eventId\"));",
              "});"
            ]
          }
        }
      ]
    },
