    {
      "name": "5 Etkinlik oluştur (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/events",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "events"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Kampüs İçin Git İşbirliği Atölyesi\",\n  \"category\": \"Atölye\",\n  \"capacity\": 30,\n  \"date\": \"2026-12-18\",\n  \"time\": \"14:00\",\n  \"location\": \"Yazılım Kulübü Çalışma Odası\",\n  \"description\": \"Küçük ekiplerle branch açma, kod inceleme ve birleştirme alıştırmaları yapılır.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Yanıt sözleşmesi\", () => {",
              "  const data = pm.response.json();",
              "  pm.expect(data._id).to.match(/^[0-9a-f]{24}$/);",
              "  pm.expect(data).to.have.property(\"createdAt\");",
              "  pm.expect(data.title).to.eql(\"Kampüs İçin Git İşbirliği Atölyesi\");",
              "  pm.collectionVariables.set(\"createdId\", data._id);",
              "});"
            ]
          }
        }
      ]
    },
